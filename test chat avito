import requests

AVITO_CLIENT_ID = "вводим свой"
AVITO_CLIENT_SECRET = "вводим свой"

def get_avito_token():
    url = "https://api.avito.ru/token"
    data = {
        "grant_type": "client_credentials",
        "client_id": AVITO_CLIENT_ID,
        "client_secret": AVITO_CLIENT_SECRET,
    }
    response = requests.post(url, data=data)
    return response.json()["access_token"]

def get_user_id(token):
    url = "https://api.avito.ru/core/v1/accounts/self"
    headers = {"Authorization": f"Bearer {token}"}
    response = requests.get(url, headers=headers)
    return response.json()["id"]

def get_chats(token, user_id):
    url = f"https://api.avito.ru/messenger/v2/accounts/{user_id}/chats"
    headers = {"Authorization": f"Bearer {token}"}
    params = {"limit": 2}
    response = requests.get(url, headers=headers, params=params)
    return response.json().get("chats", [])

def get_messages(token, user_id, chat_id):
    url = f"https://api.avito.ru/messenger/v3/accounts/{user_id}/chats/{chat_id}/messages"
    headers = {"Authorization": f"Bearer {token}"}
    params = {"limit": 10}
    response = requests.get(url, headers=headers, params=params)
    print(response.json())
    return response.json().get("messages", [])

if __name__ == "__main__":
    token = get_avito_token()
    user_id = get_user_id(token)
    chats = get_chats(token, user_id)

    # Берём первый чат и читаем сообщения
    first_chat = chats[0]
    chat_id = first_chat["id"]
    print(f"Читаем чат: {chat_id}")

    messages = get_messages(token, user_id, chat_id)
    for msg in messages:
        author = msg.get("author_id")
        text = msg.get("content", {}).get("text", "")
        print(f"Автор {author}: {text}")

def send_message(token, user_id, chat_id, text):
    url = f"https://api.avito.ru/messenger/v1/accounts/{user_id}/chats/{chat_id}/messages"
    headers = {"Authorization": f"Bearer {token}"}
    data = {
        "message": {
            "text": text
        },
        "type": "text"
    }
    response = requests.post(url, headers=headers, json=data)
    print(response.json())
    return response.json()

